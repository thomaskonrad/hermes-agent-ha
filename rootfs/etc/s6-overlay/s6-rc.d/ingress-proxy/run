#!/command/with-contenv sh
# shellcheck shell=sh
# Concept §9.2: the only app-owned service. nginx is the ingress front door on
# :8099. Refuses to start unless the access allowlist exists and was generated
# by 40-ingress-access (no `allow all` fallback).
set -eu

ACCESS=/run/hermes-ingress/supervisor-access.conf
if [ ! -s "$ACCESS" ] || ! grep -q '^deny all;$' "$ACCESS"; then
    echo "[ingress-proxy] FAIL-CLOSED: $ACCESS missing or invalid; not starting nginx" >&2
    sleep 5
    exit 1
fi

exec nginx -g 'daemon off;' -c /etc/nginx/nginx.conf
